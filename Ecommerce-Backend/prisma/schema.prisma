generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["metrics"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model products {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(255)
  brand             String    @db.VarChar(255)
  description       String
  price             Decimal   @db.Decimal(12, 2)
  category          String    @db.VarChar(255)
  stock_quantity    Int
  release_date      DateTime? @db.Timestamp(6)
  product_available Boolean?  @default(true)
  image_name        String?   @db.VarChar(255)
  image_type        String?   @db.VarChar(255)
  image_data        Bytes?
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  owner_id          Int?
  owner             users?    @relation(fields: [owner_id], references: [id], onDelete: SetNull)
  cart_items        cart_items[]
  order_items       order_items[]
}

model roles {
  id         Int       @id @default(autoincrement())
  code       String    @unique @db.VarChar(50)
  name       String    @db.VarChar(100)
  created_at DateTime  @default(now()) @db.Timestamp(6)
  users      users[]
}

model users {
  id         Int       @id @default(autoincrement())
  name       String?   @db.VarChar(255)
  email      String    @unique @db.VarChar(255)
  password   String    @db.VarChar(255)
  role       String?   @default("CUSTOMER") @db.VarChar(50)
  role_id    Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  role_record roles?   @relation(fields: [role_id], references: [id], onDelete: Restrict)
  products   products[]
  cart       carts?
  orders     orders[]
}

model carts {
  id         Int         @id @default(autoincrement())
  user_id    Int         @unique
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime    @updatedAt @db.Timestamp(6)
  user       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  items      cart_items[]
}

model cart_items {
  id         Int      @id @default(autoincrement())
  cart_id    Int
  product_id Int
  quantity   Int      @default(1)
  unit_price Decimal  @db.Decimal(12, 2)
  created_at DateTime @default(now()) @db.Timestamp(6)
  updated_at DateTime @updatedAt @db.Timestamp(6)
  cart       carts    @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  product    products @relation(fields: [product_id], references: [id], onDelete: Restrict)
  @@unique([cart_id, product_id])
  @@index([product_id])
}

model orders {
  id              Int          @id @default(autoincrement())
  user_id         Int
  status          String       @default("PENDING") @db.VarChar(30)
  total_amount    Decimal      @db.Decimal(12, 2)
  shipping_name   String       @db.VarChar(255)
  shipping_email  String       @db.VarChar(255)
  shipping_address String      @db.VarChar(500)
  created_at      DateTime     @default(now()) @db.Timestamp(6)
  updated_at      DateTime     @updatedAt @db.Timestamp(6)
  user            users        @relation(fields: [user_id], references: [id], onDelete: Restrict)
  items           order_items[]
  @@index([user_id, created_at])
  @@index([status])
}

model order_items {
  id         Int      @id @default(autoincrement())
  order_id   Int
  product_id Int
  product_name String   @db.VarChar(255)
  quantity   Int
  unit_price Decimal  @db.Decimal(12, 2)
  order      orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product    products @relation(fields: [product_id], references: [id], onDelete: Restrict)
  @@index([product_id])
}

model audit_events {
  id          Int      @id @default(autoincrement())
  occurred_at DateTime @default(now()) @db.Timestamp(6)
  request_id  String?  @db.VarChar(64)
  actor_id    Int?
  actor_role  String?  @db.VarChar(50)
  action      String   @db.VarChar(64)
  target_type String?  @db.VarChar(32)
  target_id   String?  @db.VarChar(64)
  result      String   @default("success") @db.VarChar(16)
  client_ip   String?  @db.VarChar(45)
  detail      Json?

  @@index([occurred_at(sort: Desc)])
  @@index([actor_id, occurred_at(sort: Desc)])
  @@index([request_id])
}